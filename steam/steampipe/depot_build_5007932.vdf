"DepotBuildConfig"
{
	// macOS depot. Confirm this DepotID on Steamworks -> app 5007930 -> SteamPipe
	// -> Depots (its Operating System must be set to macOS), and that it is
	// referenced by the app's package(s) — a depot not in a package never
	// reaches players.
	"DepotID" "5007932"

	// Folder holding the exported macOS build: the SolitaireTowerofDoom.app
	// bundle, with libsteam_api.dylib and the GodotSteam .dylib inside
	// SolitaireTowerofDoom.app/Contents/MacOS/. Trailing backslash required.
	"ContentRoot" "C:\Users\mjram\OneDrive\Documents\GitHub\build\mac\"

	// Ship everything in ContentRoot, recursively, to the depot root.
	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	// Never ship debug symbol files.
	"FileExclusion" "*.pdb"

	// steam_appid.txt is a local-testing marker; Steam supplies it in a real
	// install and warns if it is shipped. Keep it out of the depot.
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" "*.dSYM"
}
