# Godot 4 editor cache and generated data. Never commit these — .godot/ is
# rebuilt from source assets on open, and committing it causes constant churn
# and merge conflicts.
.godot/

# Legacy Godot 3 cache, harmless to keep ignored.
.import/

# Export output.
build/
export/
*.pck
*.exe
*.x86_64
*.dmg
*.app/
*.zip

# GodotSteam addon + Steam SDK — installed per developer, never committed.
# The redistributable binaries are covered by the Steamworks SDK Access
# Agreement, which does not permit redistribution in a public repo.
# The whole folder is ignored so it never shows up as a "change" in Git tools:
# when it did, "Discard all changes" (GitHub Desktop, VS Code) deleted the local
# install. The old patterns (addons/godotsteam/steam_api*.dll, ...) only matched
# files at the folder's top level, but the zip puts them in win64/, linuxbsd/,
# macos/, so nothing was actually ignored.
/addons/godotsteam/
steam_appid.txt
sdk/

# OS noise
.DS_Store
Thumbs.db
